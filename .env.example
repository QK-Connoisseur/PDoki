# Pumdoki environment variables (example).
# Copy to `.env` for local use. NEVER commit a real `.env` (see .gitignore).
# Only VITE_-prefixed vars are exposed to the web client.

# ── Web (apps/web) ────────────────────────────────────────────────────────
# Base URL of the API the frontend talks to.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ── API (apps/api) ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Web origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173
# PostgreSQL connection string (matches docker-compose.yml; dev database only).
DATABASE_URL=postgresql://pumdoki:pumdoki@localhost:5432/pumdoki_dev
# pino log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info
# Global rate limit scaffold (per-IP): window in ms and max requests per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ── Mail (apps/api) ────────────────────────────────────────────────────────
# console logs mail to the API log; smtp delivers to local Mailpit (npm run db:up).
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Reserved example domain only — never a real address.
MAIL_FROM=no-reply@pumdoki.example
