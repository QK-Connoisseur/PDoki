# Pumdoki environment variables (example).
# Copy to `.env` for local use. NEVER commit a real `.env` (see .gitignore).
# Only VITE_-prefixed vars are exposed to the web client.

# ── Web (apps/web) ────────────────────────────────────────────────────────
# Base URL of the API the frontend talks to.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ── API (apps/api) ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Web origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173
# PostgreSQL connection string (matches docker-compose.yml; dev database only).
DATABASE_URL=postgresql://pumdoki:pumdoki@127.0.0.1:5432/pumdoki_dev
# pino log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info
# Global rate limit scaffold (per-IP): window in ms and max requests per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ── Mail (apps/api) ────────────────────────────────────────────────────────
# smtp delivers to local Mailpit (npm run db:up); Compose binds SMTP and its
# unauthenticated inbox to 127.0.0.1 only. console is an explicit non-delivery
# sink that logs only a template identifier, never links or tokens.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Reserved example domain only — never a real address.
MAIL_FROM=no-reply@pumdoki.example

# ── Local durable worker (apps/api/src/worker) ──────────────────────────────
# Required explicitly by the separate worker process. There is deliberately no
# fallback to DATABASE_URL. This local example reuses the Compose credential;
# deployed least-privilege role provisioning remains separately gated.
WORKER_DATABASE_URL=postgresql://pumdoki:pumdoki@127.0.0.1:5432/pumdoki_dev
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
WORKER_SHUTDOWN_GRACE_MS=30000
