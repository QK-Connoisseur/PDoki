{
  "name": "@pumdoki/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "pretypecheck:content": "npm run build --workspace @pumdoki/contracts",
    "typecheck:content": "tsc -p tsconfig.content.json",
    "predev": "npm run build --workspace @pumdoki/contracts",
    "dev": "vite",
    "predev:e2e": "npm run build --workspace @pumdoki/contracts",
    "dev:e2e": "vite --host 127.0.0.1",
    "prebuild": "npm run build --workspace @pumdoki/contracts",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run build --workspace @pumdoki/contracts",
    "test": "vitest run",
    "pretest:watch": "npm run build --workspace @pumdoki/contracts",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build --workspace @pumdoki/contracts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pumdoki/contracts": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
