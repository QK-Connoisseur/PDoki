# Web client environment (apps/web). Copy to `apps/web/.env.local` for overrides.
# Only VITE_-prefixed variables are exposed to client code.

# Base URL of the Pumdoki API.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Use development only with the locally enabled content API and safe samples.
VITE_CONTENT_MODE=disabled
