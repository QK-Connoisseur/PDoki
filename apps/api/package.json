{
  "name": "@pumdoki/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker/server.ts",
    "enqueue:worker-canary": "tsx --env-file=../../.env src/worker/enqueueCanary.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "start:worker": "node --env-file=../../.env dist/worker/server.js",
    "start:e2e": "node dist/server.js",
    "test": "vitest run",
    "test:phase2-worker-spike": "tsc -p tsconfig.spike.json --noEmit && vitest run --config vitest.spike.config.ts",
    "test:phase2-worker-candidates": "tsc -p tsconfig.spike.json --noEmit && vitest run --config src/spikes/phase2WorkerCandidate.vitest.config.ts"
  },
  "dependencies": {
    "@pumdoki/contracts": "^0.1.0",
    "@pumdoki/database": "^0.1.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
