generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  CREATOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AcceptanceKind {
  TERMS
  PRIVACY
  AGE_ATTESTATION
  CREATOR_AGREEMENT
  CREATOR_CONTENT_POLICY
  IDENTITY_VERIFICATION_DISCLOSURE
}

enum CreatorApplicationStatus {
  PENDING
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum IdentityVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
}

enum VerificationTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DurableJobKind {
  PHASE2_CANARY_V1
}

enum DurableJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  DEAD
  CANCELED
  DISCARDED
}

enum DurableJobFailureCategory {
  TRANSIENT
  TIMEOUT
  DATABASE
  PAYLOAD_INVALID
  HANDLER_PERMANENT
  LEASE_EXPIRED_ATTEMPT_LIMIT
}

model User {
  id                             String                          @id @default(uuid()) @db.Uuid
  email                          String                          @unique
  passwordHash                   String
  displayName                    String
  role                           UserRole                        @default(MEMBER)
  status                         UserStatus                      @default(ACTIVE)
  emailVerifiedAt                DateTime?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  sessions                       Session[]
  acceptanceRecords              AcceptanceRecord[]
  verificationTokens             VerificationToken[]
  preference                     UserPreference?
  creatorApplication             CreatorApplication?
  creatorApplicationReviewEvents CreatorApplicationReviewEvent[]
}

model CreatorApplication {
  id                         String                     @id @default(uuid()) @db.Uuid
  userId                     String                     @unique @db.Uuid
  user                       User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  creatorName                String                     @db.VarChar(80)
  countryCode                String                     @db.Char(2)
  status                     CreatorApplicationStatus   @default(PENDING)
  identityVerificationStatus IdentityVerificationStatus @default(NOT_STARTED)
  submittedAt                DateTime                   @default(now())
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  reviewEvents CreatorApplicationReviewEvent[]

  @@index([status, submittedAt])
}

model CreatorApplicationReviewEvent {
  id                   String                   @id @default(uuid()) @db.Uuid
  creatorApplicationId String                   @db.Uuid
  creatorApplication   CreatorApplication       @relation(fields: [creatorApplicationId], references: [id], onDelete: Restrict)
  reviewerUserId       String                   @db.Uuid
  reviewerUser         User                     @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)
  fromStatus           CreatorApplicationStatus
  toStatus             CreatorApplicationStatus
  reason               String                   @db.VarChar(500)
  reviewedAt           DateTime                 @default(now())
  requestId            String                   @db.VarChar(64)
  requestIp            String?                  @db.VarChar(45)

  @@index([creatorApplicationId, reviewedAt])
  @@index([reviewerUserId, reviewedAt])
}

model UserPreference {
  userId              String   @id @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showExplicitContent Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  ipAddress      String?   @db.VarChar(45)
  userAgent      String?   @db.VarChar(512)
  lastExtendedAt DateTime  @default(now())

  @@index([userId])
}

model AcceptanceRecord {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind       AcceptanceKind
  version    String?        @db.VarChar(100)
  acceptedAt DateTime       @default(now())
  ipAddress  String         @db.VarChar(45)

  @@index([userId, kind, acceptedAt])
}

model VerificationToken {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        VerificationTokenKind
  tokenHash   String                @unique
  createdAt   DateTime              @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  requestedIp String?               @db.VarChar(45)

  @@index([userId, kind])
}

model DurableJob {
  id                    String                     @id @default(uuid()) @db.Uuid
  kind                  DurableJobKind
  payloadVersion        Int
  payload               Json
  deduplicationKeyHash  String                     @db.Char(64)
  status                DurableJobStatus           @default(PENDING)
  availableAt           DateTime                   @default(now()) @db.Timestamptz(3)
  attemptCount          Int                        @default(0)
  maxAttempts           Int
  leaseToken            String?                    @unique @db.Uuid
  leaseExpiresAt        DateTime?                  @db.Timestamptz(3)
  requestId             String                     @db.VarChar(64)
  correlationId         String?                    @db.VarChar(64)
  originalJobId         String?                    @db.Uuid
  originalJob           DurableJob?                @relation("DurableJobReplay", fields: [originalJobId], references: [id], onDelete: Restrict)
  replayJobs            DurableJob[]               @relation("DurableJobReplay")
  replaySequence        Int                        @default(0)
  lastFailureCategory   DurableJobFailureCategory?
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @db.Timestamptz(3)
  completedAt           DateTime?                  @db.Timestamptz(3)
  terminalAt            DateTime?                  @db.Timestamptz(3)
  canaryLinks           WorkerCanaryJob[]
  canaryEffectsAsSource WorkerCanaryEffect[]       @relation("WorkerCanaryEffectSourceJob")

  @@unique([kind, deduplicationKeyHash])
  @@unique([originalJobId, replaySequence])
  @@index([kind, status])
}

model WorkerCanaryIntent {
  id                 String              @id @default(uuid()) @db.Uuid
  idempotencyKeyHash String              @unique @db.Char(64)
  requestDigest      String              @db.Char(64)
  requestId          String              @db.VarChar(64)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  jobs               WorkerCanaryJob[]
  effect             WorkerCanaryEffect?
}

model WorkerCanaryJob {
  jobId          String             @id @db.Uuid
  job            DurableJob         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  canaryIntentId String             @db.Uuid
  canaryIntent   WorkerCanaryIntent @relation(fields: [canaryIntentId], references: [id], onDelete: Restrict)

  @@index([canaryIntentId])
}

model WorkerCanaryEffect {
  canaryIntentId String             @id @db.Uuid
  canaryIntent   WorkerCanaryIntent @relation(fields: [canaryIntentId], references: [id], onDelete: Restrict)
  sourceJobId    String             @unique @db.Uuid
  sourceJob      DurableJob         @relation("WorkerCanaryEffectSourceJob", fields: [sourceJobId], references: [id], onDelete: Restrict)
  appliedAt      DateTime           @default(now()) @db.Timestamptz(3)
}
