{
  "name": "pumdoki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pumdoki/web",
    "dev:web": "npm run dev --workspace @pumdoki/web",
    "dev:e2e:web": "npm run dev:e2e --workspace @pumdoki/web",
    "dev:admin": "npm run dev --workspace @pumdoki/admin",
    "build": "npm run build --workspace @pumdoki/web",
    "build:web": "npm run build --workspace @pumdoki/web",
    "build:admin": "npm run build --workspace @pumdoki/admin",
    "preview": "npm run preview --workspace @pumdoki/web",
    "preview:admin": "npm run preview --workspace @pumdoki/admin",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace @pumdoki/web",
    "test:web": "npm run test --workspace @pumdoki/web",
    "test:api": "npm run test --workspace @pumdoki/api",
    "test:phase2-worker-spike": "npm run build:api && npm run test:phase2-worker-spike --workspace @pumdoki/api",
    "test:phase2-worker-candidates": "npm run build:api && npm run test:phase2-worker-candidates --workspace @pumdoki/api",
    "test:e2e": "playwright test",
    "start:e2e:api": "npm run start:e2e --workspace @pumdoki/api",
    "dev:api": "npm run dev --workspace @pumdoki/api",
    "dev:worker": "npm run dev:worker --workspace @pumdoki/api",
    "enqueue:worker-canary": "npm run enqueue:worker-canary --workspace @pumdoki/api --",
    "start:worker": "npm run start:worker --workspace @pumdoki/api",
    "build:contracts": "npm run build --workspace @pumdoki/contracts",
    "build:database": "npm run db:generate && npm run build --workspace @pumdoki/database",
    "build:api": "npm run build:contracts && npm run build:database && npm run build --workspace @pumdoki/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --config packages/database/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config packages/database/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config packages/database/prisma.config.ts",
    "db:seed": "tsx --env-file=.env packages/database/src/seed.ts",
    "db:studio": "prisma studio --config packages/database/prisma.config.ts"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.63.0"
  }
}
